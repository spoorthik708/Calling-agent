# ==============================================================================
# YAVURA - Production-Ready SaaS Platform Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
APP_NAME=yavura-api
APP_VERSION=0.1.0
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# IMPORTANT: Generate secure 32+ character random strings in production
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
# For local Docker: postgresql+asyncpg://yavura_user:yavura_password@postgres:5432/yavura_db
# For local non-docker tests: sqlite+aiosqlite:///./test_yavura.db or local postgres
DATABASE_URL=postgresql+asyncpg://yavura_user:yavura_password@localhost:5432/yavura_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Multi-Tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Future AI Provider Configuration (Abstracted - Provider agnostic)
# Supported values: openai, anthropic, gemini, mock
DEFAULT_AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Future Telephony & Voice Configuration (Abstracted)
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=

# Future Vector Database / Knowledge Base
VECTOR_DB_TYPE=pgvector
VECTOR_SIMILARITY_THRESHOLD=0.75

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
